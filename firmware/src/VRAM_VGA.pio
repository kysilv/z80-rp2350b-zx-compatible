.pio_version 1

.program VRAM_VGA
.side_set 1 
.out 4 right auto 4
    pull block side 0
    mov y, osr side 0 ;//352 pixels, 352 bytes
.wrap_target
    wait 1 irq 2 side 0 ;// wait for active line start
    set x, 22 side 0 //21
backporch:
    jmp x-- backporch [7] side 0 ; // hline backporch and center the visible line 
    mov x, y side 1
hline:
//;    pull block side 1 ; now autopull
    out pins, 4 [2] side 1
    jmp x-- hline side 1
    set pins, 0 side 1 [15]
    nop side 1 [15]    
.wrap

% c-sdk {
static inline void VRAM_VGA_program_init(PIO pio, uint sm, uint offset, uint VGApin, uint DEpin) {
    pio_sm_config c = VRAM_VGA_program_get_default_config(offset);
//    sm_config_set_clkdiv(&c, 2.75); //56MHz
    sm_config_set_clkdiv_int_frac8(&c, 3, 128); //54MHz  at 189MHz
    sm_config_set_set_pins(&c, VGApin, 4);
    sm_config_set_out_pins(&c, VGApin, 4);
    sm_config_set_sideset_pins(&c, DEpin);

    pio_gpio_init(pio, VGApin);
    pio_gpio_init(pio, VGApin+1);
    pio_gpio_init(pio, VGApin+2);
    pio_gpio_init(pio, VGApin+3);
    pio_gpio_init(pio, DEpin);    

    pio_sm_set_consecutive_pindirs(pio, sm, VGApin, 4, true);
    pio_sm_set_consecutive_pindirs(pio, sm, DEpin, 1, true);

    pio_sm_init(pio, sm, offset, &c);

;//    pio_sm_set_enabled(pio, sm, true);
}
%}
